{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "protect-mcp 0.32.4 signed receipt",
  "description": "Payload/signature envelope written by the pinned signer; no legacy v2 envelope fields.",
  "type": "object",
  "required": [
    "payload",
    "signature"
  ],
  "properties": {
    "payload": {
      "type": "object",
      "required": [
        "tool_name",
        "reason",
        "policy_digest",
        "request_id",
        "scope",
        "mode",
        "issuer_id",
        "issued_at",
        "type",
        "decision",
        "spec",
        "issuer_certification",
        "public_key"
      ],
      "properties": {
        "tool_name": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "policy_digest": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "issuer_id": {
          "type": "string",
          "minLength": 1
        },
        "issued_at": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "protectmcp:decision"
        },
        "decision": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "spec": {
          "const": "draft-farley-acta-signed-receipts-03"
        },
        "issuer_certification": {
          "const": "self-signed"
        },
        "public_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "previousReceiptHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "payload_digest": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "signature": {
      "type": "object",
      "required": [
        "alg",
        "kid",
        "sig"
      ],
      "properties": {
        "alg": {
          "const": "EdDSA"
        },
        "kid": {
          "type": "string",
          "minLength": 1
        },
        "sig": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      }
    }
  },
  "additionalProperties": false
}
